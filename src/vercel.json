{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/ai-growth-training", "permanent": false },
    { "source": "/revenue-leak", "destination": "https://www.robinekren.com/digital-estate", "permanent": true },
    { "source": "/revenue-leak/:path*", "destination": "https://www.robinekren.com/digital-estate", "permanent": true },
    { "source": "/scorecard", "destination": "https://www.robinekren.com/digital-estate", "permanent": true },
    { "source": "/scorecard/:path*", "destination": "https://www.robinekren.com/digital-estate", "permanent": true },
    { "source": "/vision/revenue-funnel", "destination": "https://www.robinekren.com/digital-estate", "permanent": true },
    { "source": "/vision/revenue-funnel/:path*", "destination": "https://www.robinekren.com/digital-estate", "permanent": true },
    { "source": "/routine", "destination": "https://www.robinekren.com/routine", "permanent": false },
    { "source": "/routine/:path*", "destination": "https://www.robinekren.com/routine", "permanent": false },
    { "source": "/connect", "destination": "/contact", "permanent": false },
    { "source": "/crm", "destination": "/ops", "permanent": false },
    { "source": "/crm/:path*", "destination": "/ops", "permanent": false }
  ],
  "rewrites": [
    { "source": "/offers/:slug", "destination": "/offer" },
    { "source": "/onboarding", "destination": "/onboard" },
    { "source": "/onboarding/:path*", "destination": "/onboard/:path*" },
    { "source": "/onboard/:path*", "destination": "/onboard" }
  ],
  "functions": {
    "api/webhook.js": { "maxDuration": 30 },
    "api/resend-inbound.js": { "maxDuration": 30 },
    "api/fireflies-webhook.js": { "maxDuration": 30 },
    "api/cron/fireflies-retention.js": { "maxDuration": 30 },
    "api/cron/nurture.js": { "maxDuration": 60 },
    "api/cron/process-billing-outbox.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/nurture", "schedule": "0 9 * * *" },
    { "path": "/api/cron/fireflies-retention", "schedule": "15 2 * * *" },
    { "path": "/api/cron/process-billing-outbox", "schedule": "*/5 * * * *" }
  ]
}
